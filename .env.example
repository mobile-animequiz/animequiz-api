# Private backend settings. Configure them in your host; do not commit .env.
JWT_SECRET=
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:h2:file:/var/data/animequizdb;DB_CLOSE_ON_EXIT=FALSE
# Requires a persistent disk at /var/data. Default local profile writes ./data.
PUBLIC_APP_ORIGIN=https://animequiz-api-wst8.onrender.com
GOOGLE_CLIENT_IDS=
MAIL_API_KEY=
MAIL_FROM=
CORS_ALLOWED_ORIGINS=http://localhost:8081
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ENABLED=true
CATALOG_SEED_ENABLED=true

