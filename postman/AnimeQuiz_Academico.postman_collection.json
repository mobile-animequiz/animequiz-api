              }
            }
          ]
        },
        {
          "name": "09 — Meu perfil e XP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Version",
                "value": "2"
              },
              {
                "key": "Accept",
                "value": "application/json"
