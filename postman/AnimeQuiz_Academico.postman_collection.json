            ],
            "url": "{{baseUrl}}/users/{{userId}}/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 — Atualizar meu nome",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Version",
                "value": "2"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Jogador da apresentação\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 — Favoritar quiz",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-Version",
                "value": "2"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me/favorites/{{quizId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 — Meus favoritos",
          "request": {
            "method": "GET",
